generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

generator scriptsClient {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma-cjs"
}

datasource db {
  provider = "postgresql"
}

enum Vertical {
  kids
  men
  women
}

// Which part of the body a Clothing product covers. Used to gate virtual
// try-on: the current model only supports upper-body garments.
enum GarmentRegion {
  upper_body
  lower_body
  dresses
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  addresses Address[]
  orders    Order[]

  @@map("users")
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String
  phone     String
  line1     String
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String
  price         Int
  originalPrice Int?     @map("original_price")
  rating        Float    @default(0)
  reviewCount   Int      @default(0) @map("review_count")
  tag           String?
  category      String
  emoji         String
  // Tailwind gradient class (e.g. "bg-sky-100") used for card-background
  // theming -- NOT the product's physical color. Predates variant grouping;
  // kept as-is to avoid touching every place that reads it for styling.
  // The actual garment/variant color lives in `variantColor` below.
  color         String
  image         String?
  stock         Int      @default(0)
  // Per-size breakdown from catalog import: [{ size, quantity, available }].
  // Null for products never touched by the import (manually added via the
  // admin form, which only tracks the single `stock` count).
  sizes         Json?
  inStock       Boolean  @default(true) @map("in_stock")
  vertical      Vertical @default(kids)
  garmentRegion GarmentRegion? @map("garment_region")
  createdAt     DateTime @default(now()) @map("created_at")

  // Variant grouping (Amazon-style color swatches under one listing).
  // Nullable for backward compatibility -- most existing products predate
  // grouping and stay ungrouped (a "group of one") until explicitly grouped.
  productGroupId Int?     @map("product_group_id")
  productGroup   ProductGroup? @relation(fields: [productGroupId], references: [id], onDelete: SetNull)
  // Physical variant color (e.g. "Blue Stripes"), distinct from the
  // pre-existing `color` field above. Only meaningful once a product is
  // grouped, but left independently settable (not required) since a
  // standalone product can still have a known color.
  variantColor   String?  @map("variant_color")

  cartItems CartItem[]

  @@unique([name, vertical])
  @@index([productGroupId])
  @@map("products")
}

// The shared listing info across all color variants of the same item
// (e.g. "Cotton Onesie" grouping "Blue Stripes" and "Red Stripes" Products).
// Introduced for Amazon-style variant grouping -- see Product.productGroupId.
model ProductGroup {
  id          Int      @id @default(autoincrement())
  name        String
  vertical    Vertical
  category    String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("product_groups")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    String   @map("cart_id")
  productId Int      @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id                Int      @id @default(autoincrement())
  userId            Int?     @map("user_id")
  addressId         Int?     @map("address_id")
  razorpayOrderId   String   @map("razorpay_order_id")
  razorpayPaymentId String   @unique @map("razorpay_payment_id")
  total             Int
  items             Json
  shippingAddress   Json     @map("shipping_address")
  createdAt         DateTime @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  address Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  @@map("orders")
}
