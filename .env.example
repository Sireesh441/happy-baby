# Copy to .env.local and fill in real values. Never commit .env.local itself.
# Real values live in the Vercel dashboard (Project Settings -> Environment
# Variables) -- pull them anytime with `vercel env pull .env.local`.

# NextAuth (web sessions)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Mobile JWT signing (lib/mobileJwt.ts) -- shared with fit-engine and
# returns-protection, which verify the same token.
JWT_SECRET=

# Razorpay payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# "Ask Happy Shopping" assistant
ANTHROPIC_API_KEY=

# Supabase Postgres via Prisma -- DATABASE_URL must be the pooled connection
# (port 6543, ?pgbouncer=true); DIRECT_URL (port 5432) is for migrations only.
DATABASE_URL=
DIRECT_URL=

# Standalone microservices this app proxies to
TRYON_SERVICE_URL=
RETURNS_SERVICE_URL=

# Cloudinary (product-import image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel OIDC (auto-managed by `vercel env pull`, not something to set by hand)
VERCEL_OIDC_TOKEN=
